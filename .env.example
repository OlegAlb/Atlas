# Скопируйте в .env и заполните ключи.
# С этим файлом по умолчанию всё работает без ключей:
# эмбеддинги и реранкер переключаются на noop-заглушки.

PORT=3000

# --- LLM (Groq) ---------------------------------------------------------
# Внимание: /chat требует реальный ключ, noop-провайдера для LLM нет.
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- Эмбеддинги ---------------------------------------------------------
# jina — реальные эмбеддинги, нужен EMBEDDING_API_KEY.
# noop — детерминированная заглушка, ключ не нужен.
EMBEDDING_PROVIDER=noop
EMBEDDING_API_KEY=
EMBEDDING_MODEL=jina-embeddings-v5-text-small

# --- Реранкер -----------------------------------------------------------
RERANKING_PROVIDER=noop
RERANKING_API_KEY=
RERANKING_MODEL=jina-reranker-v3
